struct BinaryLifting {
    long long n;
    long long maxK;
    long long maxPower;
    vector<vector<long long>> parent;
    vector<long long> level;

    // Constructor: O(n * log(maxK))
    BinaryLifting(long long n1, long long root, vector<vector<long long>>& edges, long long maxK)
        : n(n1),
          maxK(maxK),
          maxPower(log2(maxK + 5)),
          parent(n, vector<long long>(maxPower + 5, -1)),
          level(n, 0)
    {
        fillParentTable(root, edges);  // fills parent[][] and level[]
    }

    // Fills parent table and level[]: O(n * log(maxK))
    void fillParentTable(long long root, vector<vector<long long>>& edges) {
        vector<bool> visited(n);
        dfsBinaryLifting(root, -1, 0, edges, visited);  // DFS: O(n)

        // Filling sparse table: O(n * log(maxK))
        for (long long i = 1; i <= maxPower; i++) {
            for (long long node = 0; node < n; node++) {
                long long midParent = parent[node][i - 1];
                if (midParent != -1) {
                    parent[node][i] = parent[midParent][i - 1];
                }
            }
        }
    }

    // DFS to fill parent[0] and level[]: O(n)
    void dfsBinaryLifting(long long node, long long par, long long depth, vector<vector<long long>>& edges, vector<bool>& visited) {
        visited[node] = true;
        parent[node][0] = par;
        level[node] = depth;

        for (auto& child : edges[node]) {
            if (!visited[child]) {
                dfsBinaryLifting(child, node, depth + 1, edges, visited);
            }
        }
    }

    // Returns the kth parent of node: O(log(k))
    long long kthParent(long long node, long long k) {
        for (long long i = 0; i <= maxPower && node != -1; i++) {
            if (k & (1 << i)) {
                node = parent[node][i];
            }
        }
        return node;
    }

    // Returns LCA of u and v: O(log(n))
    long long LCA(long long u, long long v) {
        if (level[u] < level[v]) swap(u, v);

        // Step 1: Lift u up to v's level: O(log(n))
        long long diff = level[u] - level[v];
        u = kthParent(u, diff);

        if (u == v) return u;

        // Step 2: Lift both up until they meet: O(log(n))
        for (long long i = maxPower; i >= 0; i--) {
            if (parent[u][i] != -1 && parent[u][i] != parent[v][i]) {
                u = parent[u][i];
                v = parent[v][i];
            }
        }

        // Step 3: Return their parent
        return parent[u][0];
    }
};

